#!/bin/sh
# Siba OS - live-build configuration
# Built by Sorokhaibam Nungsiba Singh

set -e

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi,syslinux" \
    --debian-installer live \
    --debian-installer-gui true \
    --iso-application "Siba OS" \
    --iso-publisher "Sorokhaibam Nungsiba Singh" \
    --iso-volume "SIBA_OS_1_0" \
    --image-name "siba-os" \
    --linux-flavours amd64 \
    --linux-packages "linux-image linux-headers" \
    --security true \
    --updates true \
    --firmware-chroot true \
    --apt-recommends true \
    --bootappend-live "boot=live components quiet splash username=siba hostname=siba-os locales=en_US.UTF-8 keyboard-layouts=us" \
    "${@}"
