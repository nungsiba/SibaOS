#!/bin/sh
# Siba OS identity, defaults and first-boot setup.
set -e

# --- os-release ---------------------------------------------------------
cat > /etc/os-release <<'EOF'
PRETTY_NAME="Siba OS 1.0 (Aurora)"
NAME="Siba OS"
VERSION_ID="1.0"
VERSION="1.0 (Aurora)"
VERSION_CODENAME=aurora
ID=siba
ID_LIKE=debian
HOME_URL="https://github.com/"
BUG_REPORT_URL="https://github.com/"
BUILT_BY="Sorokhaibam Nungsiba Singh"
EOF

echo "Siba OS 1.0 (Aurora) \n \l" > /etc/issue
echo "Siba OS 1.0 (Aurora)" > /etc/issue.net
echo "siba-os" > /etc/hostname

# --- dconf defaults (theme, dock, fonts) --------------------------------
dconf update || true

# --- zram: compressed swap, helps on 8 GB machines -----------------------
cat > /etc/default/zramswap <<'EOF'
ALGO=zstd
PERCENT=40
EOF

# --- default shell -------------------------------------------------------
sed -i 's#^DSHELL=.*#DSHELL=/bin/bash#' /etc/adduser.conf 2>/dev/null || true

# --- executable helper scripts --------------------------------------------
chmod +x /usr/local/bin/siba-welcome /usr/local/bin/siba-info 2>/dev/null || true

# --- trim cache -----------------------------------------------------------
apt-get clean
rm -rf /var/lib/apt/lists/*
