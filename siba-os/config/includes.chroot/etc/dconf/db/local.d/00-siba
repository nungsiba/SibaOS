# Siba OS default desktop settings

[org/gnome/desktop/interface]
color-scheme='default'
gtk-theme='Adwaita'
icon-theme='Papirus'
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='JetBrains Mono 10'
clock-show-weekday=true
show-battery-percentage=true
enable-hot-corners=false
enable-animations=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/siba/siba-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/siba/siba-dark.svg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/siba/siba-light.svg'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Inter Bold 10'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com','appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['firefox-esr.desktop','code.desktop','org.gnome.Terminal.desktop','org.gnome.Nautilus.desktop','siba-whatsapp.desktop','siba-gmail.desktop','org.gnome.Software.desktop','libreoffice-writer.desktop','siba-welcome.desktop','org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
transparency-mode='FIXED'
background-opacity=0.55
custom-theme-shrink=true
dash-max-icon-size=48
show-trash=false
show-mounts=false
click-action='minimize-or-previews'
apply-custom-theme=false

[org/gnome/mutter]
dynamic-workspaces=true
edge-tiling=true
center-new-windows=true

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'

[org/gnome/terminal/legacy]
theme-variant='system'

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
