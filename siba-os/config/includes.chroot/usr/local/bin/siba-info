#!/bin/sh
# Prints a short Siba OS system summary.
. /etc/os-release
echo "$PRETTY_NAME"
echo "Built by:  $BUILT_BY"
echo "Kernel:    $(uname -r)"
echo "CPU:       $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
echo "Memory:    $(free -h | awk '/Mem:/ {print $3 " used / " $2}')"
echo "Disk (/):  $(df -h / | awk 'NR==2 {print $3 " used / " $2}')"
echo "Shell:     $SHELL"
